# RegLens AI - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED SETTINGS
# ============================================

# Groq API Key (required)
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here

# ============================================
# CORS & DEPLOYMENT
# ============================================

# Comma-separated list of allowed origins
# For local development: http://localhost:3000,http://localhost:8501
# For production: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# ============================================
# DATABASE
# ============================================

# SQLite (development) or PostgreSQL (production)
# SQLite: sqlite:///./data/reglens.db
# PostgreSQL: postgresql://user:password@localhost:5432/reglens
DATABASE_URL=sqlite:///./data/reglens.db

# ============================================
# ENVIRONMENT
# ============================================

# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# API URLS
# ============================================

# Backend API URL (used by Streamlit frontend)
# For local: http://localhost:8000
# For Docker Compose: http://backend:8000
# For production: https://api.yourdomain.com
BACKEND_API_URL=http://localhost:8000

# ============================================
# ADVANCED (Optional)
# ============================================

# Database connection timeout (seconds)
DB_TIMEOUT=10


# Rate limiting
# Compliance check: requests per minute
RATE_LIMIT_COMPLIANCE=10
# History endpoint: requests per minute
RATE_LIMIT_HISTORY=30

# Cache settings (if implementing caching)
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600

# Encryption key for sensitive data (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# ENCRYPTION_KEY=your_encryption_key_here
