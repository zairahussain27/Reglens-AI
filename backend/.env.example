# RegLens AI - Backend Configuration Template
# Copy this file to backend/.env or root .env

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Qdrant Cloud Vector Database
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=regulations

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# SQLite Audit Database Path
DATABASE_PATH=data/reglens.db

# CORS & Server Settings
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
